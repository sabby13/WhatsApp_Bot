# ============================================================
# WhatsApp Bot — environment config (copy to .env, never commit .env)
# Milestone 2 uses: APP_*, LOG_LEVEL, OPENWA_WEBHOOK_SECRET, IGNORE_*.
# The AI/whitelist/kill-switch vars are documented now but not used until M3+.
# ============================================================

# --- Our app (FastAPI backend) ---
# Bind to 0.0.0.0 so the OpenWA Docker container can reach us via host.docker.internal.
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO            # set to DEBUG to also log the raw webhook payload (handy for inspecting the exact shape)

# --- OpenWA connection ---
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=            # from the OpenWA dashboard/Swagger (needed to register the webhook & to send, M4)
OPENWA_SESSION_ID=whatsapp-bot
# If set, inbound webhooks must be HMAC-SHA256 signed with this secret.
# Leave BLANK for the first Milestone 2 test; set it (and the same value in the OpenWA webhook) to enable signing.
OPENWA_WEBHOOK_SECRET=

# --- Safeguards active in Milestone 2 ---
IGNORE_GROUPS=true
IGNORE_SELF=true

# --- AI provider (Milestone 3+) — provider-independent ---
AI_PROVIDER=ollama
AI_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Safeguards active from Milestone 4+ ---
BOT_ENABLED=false          # GLOBAL KILL SWITCH. Must be true before ANY reply is sent.
WHITELIST_ONLY=true        # only whitelisted contacts can ever trigger AI
CONTACT_WHITELIST=         # comma-separated whatsapp ids; start with exactly ONE
IGNORE_UNKNOWN=true
REPLY_RATE_LIMIT_PER_MIN=3
