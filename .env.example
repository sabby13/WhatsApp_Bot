# ============================================================
# WhatsApp Bot — environment config (copy to .env, never commit .env)
# .env is gitignored. Fill in real values in .env only.
# ============================================================

# --- Our app (FastAPI backend) ---
# Bind to 0.0.0.0 so the OpenWA Docker container can reach us via host.docker.internal.
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO            # set to DEBUG to also log the raw webhook payload

# --- OpenWA connection ---
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=            # from the OpenWA dashboard/Swagger (used to register webhook & to send in M4)
OPENWA_SESSION_ID=whatsapp-bot
OPENWA_WEBHOOK_SECRET=     # optional: set to require HMAC-signed webhooks (same value in the OpenWA webhook)

# --- Safeguards active now ---
IGNORE_GROUPS=true
IGNORE_SELF=true

# --- AI provider (Milestone 3) — provider-independent ---
AI_PROVIDER=groq           # groq now; later: ollama | xai | gemini | openai-compatible
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.7

# GroqCloud (https://console.groq.com/keys). Put your real key in .env ONLY — never commit it.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant          # current production model; alt: llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Safeguards active from Milestone 4+ (reply sending) ---
BOT_ENABLED=false          # GLOBAL KILL SWITCH. Must be true before ANY reply is sent.
WHITELIST_ONLY=true        # only whitelisted contacts can ever trigger a sent reply
CONTACT_WHITELIST=         # comma-separated whatsapp ids; start with exactly ONE
IGNORE_UNKNOWN=true
REPLY_RATE_LIMIT_PER_MIN=3
