# ============================================================
# WhatsApp Bot — environment config (copy to .env, never commit .env)
# NOTE: nothing here is used until Milestone 2. It documents the
# variables our FastAPI app will read as we build it out.
# ============================================================

# --- OpenWA connection (Milestone 2+) ---
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=            # generated by OpenWA on first run (see Milestone 1 doc)
OPENWA_SESSION_ID=         # the session name/id you create in OpenWA
OPENWA_WEBHOOK_SECRET=     # HMAC secret to verify inbound webhooks

# --- Our app ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- AI provider (Milestone 3+) — provider-independent ---
AI_PROVIDER=ollama
AI_MODEL=llama3.1          # any model you have pulled in Ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Safeguards (Milestone 4+) — all default to SAFE ---
BOT_ENABLED=false          # GLOBAL KILL SWITCH. Must be true for ANY reply to be sent.
WHITELIST_ONLY=true        # only whitelisted contacts can ever trigger AI
CONTACT_WHITELIST=         # comma-separated whatsapp ids; start with exactly ONE
IGNORE_GROUPS=true
IGNORE_UNKNOWN=true
IGNORE_SELF=true
REPLY_RATE_LIMIT_PER_MIN=3 # max auto-replies per contact per minute
