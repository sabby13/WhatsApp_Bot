# ============================================================
# WhatsApp Bot — environment config (copy to .env, never commit .env)
# .env is gitignored. Fill in real values in .env only.
# ============================================================

# --- Our app (FastAPI backend) ---
APP_HOST=0.0.0.0          # 0.0.0.0 so the OpenWA container can reach us via host.docker.internal
APP_PORT=8000
LOG_LEVEL=INFO            # DEBUG also logs the raw webhook payload

# --- OpenWA connection (webhook in + send out) ---
OPENWA_BASE_URL=http://localhost:2785     # /api is appended automatically; a trailing /api is tolerated
OPENWA_API_KEY=           # OpenWA seed key (see below) — NEVER commit; never logged
OPENWA_SESSION=whatsapp-bot               # (OPENWA_SESSION_ID also accepted)
OPENWA_WEBHOOK_SECRET=    # optional: require HMAC-signed inbound webhooks

# --- Milestone 4: controlled outbound sending ---
BOT_ENABLED=false                          # GLOBAL KILL SWITCH. Leave false until you are ready to send.
WHITELISTED_CONTACTS=                       # comma-separated ids (@lid or @c.us). Start with EXACTLY ONE.
MAX_AUTO_REPLIES_PER_MINUTE=5               # per-contact in-memory rate limit

# --- Safeguards ---
IGNORE_GROUPS=true
IGNORE_SELF=true

# --- AI provider (Milestone 3) — provider-independent ---
AI_PROVIDER=groq           # groq now; later: ollama | xai | gemini | openai-compatible
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.7

# GroqCloud (https://console.groq.com/keys). Real key in .env ONLY.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant           # production model; alt: llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
